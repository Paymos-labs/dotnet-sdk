<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Paymos/Paymos.csproj" />
    <Compile Include="../Paymos.Tests/RefundsTests.cs" Link="RefundsTests.cs" />
    <Compile Include="../Paymos.Tests/TonWebhookTests.cs" Link="TonWebhookTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../conformance/contract.json" Link="contract.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RunConformanceTests" BeforeTargets="VSTest" DependsOnTargets="Build">
    <Exec Command="dotnet &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
